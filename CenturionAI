    # The number of models MUST equal the number of engines. 1 model per engine

    if ec!=mc!=mt:
        ErrorLog(f"Broke GB ((models/Encoding)!=engines!=MaxTokens): {sys.exc_info()[-1].tb_lineno}/{err}")
        return PickRandomResponse(bot['Broken'])

    # Run through the engins/models until we have a response.

    response=None
    ecounter=0
    while response==None and ecounter<ec:
        userhome=f"{ConfigStorage}/{gid}"

        ### Set up agent core from JackrabbitAI
        dn=f"{MemoryStorage}/{gid}/{bot['BotName']}"
        fn=f"{dn}/{bot['BotName']}.{uid}.{channel}"
        agent=AI.Agent(engine=el[ecounter],model=ml[ecounter],maxtokens=int(tl[ecounter]),temperature=bot['Temperature'],freqpenalty=bot['freqpenalty'],persona=bot['BotName'],maxmem=bot['MaxMemory'],userhome=userhome)
        agent.SetMemory(memory=f"{fn}.memory",timing=f"{fn}.timing")
        agent.Discord(gid,channel,nsfw)
